# Copy to /mnt/onboard/.adds/dogear/config.env and fill in the three values.
# SUPABASE_URL and the anon / public key are from Supabase → Settings → API.
# DOGEAR_INGEST_TOKEN is created on the Dogear account page. It can write
# highlights only for that one account, and you can revoke it there.
#
# Do not put a service role key in this file. If one was copied onto the Kobo
# already, remove it and regenerate that key in Supabase.

SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="eyJ...anon-public-key..."
DOGEAR_INGEST_TOKEN="dogear_..."
