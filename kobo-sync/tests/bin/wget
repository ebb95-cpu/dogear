#!/bin/sh
# Test double for the Kobo busybox wget path.
if [ "${1:-}" = "--help" ]; then
  echo "busybox wget"
  echo "--post-file FILE"
  exit 0
fi
dir=${DOG_CURL_DIR:?}
mkdir -p "$dir"
n=$(find "$dir" -name 'attempt-*' 2>/dev/null | wc -l | tr -d ' ')
n=$((n + 1))
: > "$dir/attempt-$n"
echo wget > "$dir/client-$n.txt"
out=/dev/null
data=
while [ $# -gt 0 ]; do
  case "$1" in
    -O) out=$2; shift 2 ;;
    --post-file) data=$2; shift 2 ;;
    --post-file=*) data=${1#--post-file=}; shift ;;
    --header=*) printf '%s\n' "${1#--header=}" >> "$dir/headers-$n.txt"; shift ;;
    --header) printf '%s\n' "$2" >> "$dir/headers-$n.txt"; shift 2 ;;
    -T|-S|-q) shift ;;
    http://*|https://*) shift ;;
    *) shift ;;
  esac
done
if [ -n "$data" ] && [ -f "$data" ]; then
  cp "$data" "$dir/body-$n.json"
fi
echo "  HTTP/1.1 200 OK" >&2
printf '%s' '{"ok":true,"books":1,"highlights":1}' > "$out"
exit 0
